  "c11",            # disponibilidad para trabajar más horas — serie completa
  "b15_1",          # tamaño de empresa — serie completa (manual sin observaciones)
  "tpi",            # tiempo parcial involuntario — serie completa
  "obe",            # ocupado que buscó empleo — serie completa
