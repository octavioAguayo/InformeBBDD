  "nacionalidad",   # nativa, siempre presente — fc_nacionalidad() → 1=chileno, 2=extranjero
  "cine11_2d"       # nativa, siempre presente — fc_nivel_educativo() → 5 categorías; 99=NS/NR → NA
)
# Solo variables con vigencia POSTERIOR a 201002 (manual, col. Observaciones).
# INVARIANTE: contiene EXACTAMENTE las variables con vigencia posterior a
# 201002. Sin observaciones en el manual = serie completa = vars_base. Una de
# serie completa puesta acá no falla: se rellena con NA, se suma como 0 y el
# cero se publica. Se verifica con ENE_0b_BBDD_Etiquetas.R, que lo mide.
vars_opcionales <- c(
  "ocup_form",          # desde JAS 2017 (manual p.69)
  "id","idisp",         # iniciador disponible. El INE renombró id → idisp
  # en 201912: id rige 201002-201911 e idisp desde
  # 201912. No se traslapan nunca. Van las dos acá y
  # el rename de abajo las unifica.
  "ciso2","ciso3_b",    # desde EFM 2020 (xxx)
  "b14_rev4cl_caenes",  # rama de la empresa donde trabaja, desde EFM 2013 (manual p.36)
  "r_p_rev4cl_caenes",   # rama ajustada de la unidad pagadora/propietaria, desde JAS 2017
  "sector",             # desde JAS 2017 (manual p.69)
  "b1",                 # grupo ocupacional CIUO-08, desde EFM 2017 (manual p.30)
  "deseo_trabajar",     # fuera de FT con deseo de trabajar — desde EFM 2020 (manual p.57)
  "e22"                 # JJA 2020, recomendadas por OIT en el contexto del impacto de la pandemia de COVID-19 en la población no ocupada (INE, 2020d).
)

leer_ene_cache <- function(archivo) {
  vars_dta <- names(read_dta(archivo, n_max = 0))
  vars_esperadas <- c(vars_base, intersect(vars_opcionales, vars_dta))
  ruta_cache <- file.path(
    dire_cache,
    paste0(tools::file_path_sans_ext(basename(archivo)), ".rds")
  )

  if (!RECREAR_CACHE && file.exists(ruta_cache) &&
      file.info(ruta_cache)$mtime >= file.info(archivo)$mtime) {
    cache_obj <- tryCatch(readRDS(ruta_cache), error = function(e) NULL)
    cache_valida <- !is.null(cache_obj) &&
      identical(attr(cache_obj, "cache_lectura_version"), CACHE_LECTURA_VERSION) &&
      identical(attr(cache_obj, "vars_esperadas"), vars_esperadas) &&
      all(vars_esperadas %in% names(cache_obj))
    if (cache_valida) {
      return(cache_obj)
    }
  }

  cache_obj <- read_dta(archivo, col_select = all_of(vars_esperadas)) %>%
    mutate(across(everything(), ~ as.numeric(haven::zap_labels(.))))
  attr(cache_obj, "cache_lectura_version") <- CACHE_LECTURA_VERSION
  attr(cache_obj, "vars_esperadas") <- vars_esperadas
  attr(cache_obj, "dta_origen") <- normalizePath(
    archivo, winslash = "/", mustWork = FALSE
  )
  saveRDS(cache_obj, ruta_cache)
  cache_obj
}

# ==============================================================================
# FUNCIÓN PRINCIPAL: procesa un .dta → resumen sexo × region ####
# Un solo group_by con todas las dimensiones base del cubo.
# AS y Nacional se construyen después por colapso — no dentro de esta función.
# ==============================================================================

procesar_dta <- function(archivo) {
  ene <- leer_ene_cache(archivo)
  
  # Trampa: sin esto, Iniciadores_disp sale 0 en los 118 períodos anteriores
  # a 201912. La columna no se lee, sum() sobre lo que no está devuelve 0 y
  # no NA, y el cero se publica como dato.
  if ("id" %in% names(ene)) ene <- rename(ene, idisp = id)
  
  # Rellenar opcionales ausentes con NA ####
  # Se avisa cuáles: un relleno silencioso se publica como 0.
  ausentes <- setdiff(vars_opcionales, names(ene))
  if (length(ausentes))
    message("  ", basename(archivo), " — opcionales ausentes: ",
            paste(ausentes, collapse = ", "))
  for (v in ausentes) ene[[v]] <- NA_integer_
  
  # Período ####
  ene <- ene %>%
    mutate(
      periodo = ano_trimestre * 100 + mes_central,
      fecha   = make_date(ano_trimestre, mes_central, 1)
    )
  
  # Indicadores derivados: calcular si no vienen en el .dta ####
  # tpi: habituales < 31 & c10==1 & c11 %in% c(1,2)
  if (all(is.na(ene$tpi)) && "c10" %in% names(ene) && "c11" %in% names(ene)) {
    ene <- ene %>%
      mutate(tpi = as.integer(cae_especifico %in% 1:7 & habituales < 31 &
                                c10 == 1 & c11 %in% c(1, 2)))
  }
  
  # Dimensiones adicionales del cubo ####
  # Se construyen antes del summarise — necesitan microdatos
  ene <- ene %>%
    mutate(
      nacionalidad    = fc_nacionalidad(nacionalidad),
      nivel_educativo = fc_nivel_educativo(if_else(cine11_2d == 99, NA_real_, cine11_2d)),
      tramo_edad      = fc_t_edad_ine(tramo_edad),
      tamano_empresa  = case_when(
        b15_1 %in% c(1, 2)  ~ 1L,   # Micro    (1-10 personas)
        b15_1 == 3           ~ 2L,   # Pequeña  (11-49)
        b15_1 == 4           ~ 3L,   # Mediana  (50-199)
        b15_1 == 5           ~ 4L,   # Gran     (200+)
        b15_1 %in% c(88, 99) ~ 5L,   # Sin clasificar (NS/NR)
        TRUE                 ~ NA_integer_
      )
    )
  
  # ===========================================================================
  # SUMMARISE — group_by único: periodo × fecha × sexo × region × nacionalidad × nivel_educativo × tramo_edad
  # Produce stocks base (Tipo 1) y auxiliares de paso (Tipo 2).
  # Las derivadas (tasas, promedios, identidades) se calculan en post-proceso.
  # AS y Nacional se construyen después por colapso OLAP — no dentro de esta función.
  # ===========================================================================
  
  ene %>%
    group_by(periodo, fecha, sexo, region, nacionalidad, nivel_educativo, tramo_edad) %>%
    summarise(
      
      # --- Mercado laboral principal ---
      Poblacion        = sum(fact_cal,                                          na.rm = TRUE),
      PET              = sum(fact_cal[edad >= 15],                              na.rm = TRUE),
      FT               = sum(fact_cal[cae_especifico %in% 1:9],                 na.rm = TRUE),
      Ocupados         = sum(fact_cal[cae_especifico %in% 1:7],                 na.rm = TRUE),
      Desocupados      = sum(fact_cal[cae_especifico %in% c(8, 9)],             na.rm = TRUE),
      Cesantes         = sum(fact_cal[cae_especifico == 8],                     na.rm = TRUE),
      B_t_p_v          = sum(fact_cal[cae_especifico == 9],                     na.rm = TRUE),
      FFT              = sum(fact_cal[activ == 3],                              na.rm = TRUE),
      FFT_Iniciadores  = sum(fact_cal[cae_especifico %in% c(10, 11)],           na.rm = TRUE),
      FFT_Inactivos_PA = sum(fact_cal[!is.na(ftp) & ftp == 1],                  na.rm = TRUE),
      FFT_Inactivos_H  = sum(fact_cal[activ == 3 &
                                        !cae_especifico %in% c(10, 11) &
                                        (is.na(ftp) | ftp == 0)],               na.rm = TRUE),
      
      # --- Subutilización ---
      Iniciadores_disp       = sum(fact_cal[!is.na(idisp)  & idisp  == 1],      na.rm = TRUE),
      Tiemp_parcial_involunt = sum(fact_cal[!is.na(tpi) & tpi == 1],            na.rm = TRUE),
      Ocup_buscaron_empleo   = sum(fact_cal[!is.na(obe) & obe == 1],            na.rm = TRUE),
      FT_potencial           = sum(fact_cal[!is.na(ftp) & ftp == 1],            na.rm = TRUE),
      FT_ampliada            = sum(fact_cal[cae_especifico %in%
                                              c(1:9, 10, 12, 14, 16, 18, 20, 22, 25, 26, 27)],
                                   na.rm = TRUE),
      Desea_trabajar         = sum(fact_cal[!is.na(deseo_trabajar) &
                                              deseo_trabajar == 1],             na.rm = TRUE),
      
      # --- Categoría ocupacional ---
      Empleadores       = sum(fact_cal[activ==1 & categoria_ocupacion==1],      na.rm = TRUE),
      Cuenta_propia     = sum(fact_cal[activ==1 & categoria_ocupacion==2],      na.rm = TRUE),
      Asal_privados     = sum(fact_cal[activ==1 & categoria_ocupacion==3],      na.rm = TRUE),
      Asal_publico      = sum(fact_cal[activ==1 & categoria_ocupacion==4],      na.rm = TRUE),
      ServDom_afuera    = sum(fact_cal[activ==1 & categoria_ocupacion==5],      na.rm = TRUE),
      ServDom_adentro   = sum(fact_cal[activ==1 & categoria_ocupacion==6],      na.rm = TRUE),
      Familiares_no_rem = sum(fact_cal[activ==1 & categoria_ocupacion==7],      na.rm = TRUE),
      
      
      
      
      # =========================================================================
      # CATEGORÍA OCUPACIONAL ciso2 (Excel Coyuntura - Vigencia 202002+)
      # =========================================================================
      
      ciso_Indepen_Total   = sum(fact_cal[activ==1 & ciso2 %in% 1:2], na.rm = TRUE),
      ciso_Indepen_Form    = sum(fact_cal[activ==1 & ciso2 %in% 1:2 & !is.na(ocup_form) & ocup_form==1], na.rm = TRUE),
      ciso_Indepen_Inform  = sum(fact_cal[activ==1 & ciso2 %in% 1:2 & !is.na(ocup_form) & ocup_form==2], na.rm = TRUE),
      
