      ciso_Dependi_Inform  = sum(fact_cal[activ==1 & ciso2 %in% 3:7 & !is.na(ocup_form) & ocup_form==2], na.rm = TRUE),
      
      
      ciso_Emplead_Total     = sum(fact_cal[activ==1 & ciso2==1], na.rm = TRUE),
      ciso_Emplead_Form      = sum(fact_cal[activ==1 & ciso2==1 & !is.na(ocup_form) & ocup_form==1], na.rm = TRUE),
      ciso_Emplead_Inform    = sum(fact_cal[activ==1 & ciso2==1 & !is.na(ocup_form) & ocup_form==2], na.rm = TRUE),
      
      ciso_CPropia_Total     = sum(fact_cal[activ==1 & ciso2==2], na.rm = TRUE),
