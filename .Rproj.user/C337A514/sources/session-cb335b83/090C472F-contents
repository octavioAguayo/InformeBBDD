# ==============================================================================
# PROCESAR TODOS LOS ARCHIVOS — CICLO ÚNICO ####
# ==============================================================================

handlers(global = TRUE)
handlers("txtprogressbar")

lista <- list()
with_progress({
  p <- progressor(steps = length(archivos))
  for (archivo in archivos) {
    p(message = paste0("Procesando: ", basename(archivo)))
    lista[[archivo]] <- procesar_dta(archivo)
  }
})

resumen_base <- bind_rows(resumen_base_ant, bind_rows(lista), resumen_base_post) %>%
  arrange(periodo, sexo, region)
rm(lista, resumen_base_ant, resumen_base_post)

# Contrato de rama: 63 columnas r_p y 63 b14. En r_p el total se define sobre
# la misma partición de formalidad, por lo que debe ser idéntico a F + I.
cols_rama_b14 <- grep("^Rama_.*_b14$", names(resumen_base), value = TRUE)
cols_rama_rp <- setdiff(grep("^Rama_", names(resumen_base), value = TRUE),
                        cols_rama_b14)
if (length(cols_rama_rp) != 63L || length(cols_rama_b14) != 63L) {
  stop("Contrato de rama incompleto: r_p=", length(cols_rama_rp),
       ", b14=", length(cols_rama_b14), "; se esperaban 63 y 63.")
}

dif_rama_rp <- as.matrix(resumen_base[cols_rama_rp[1:21]]) -
  as.matrix(resumen_base[cols_rama_rp[22:42]]) -
  as.matrix(resumen_base[cols_rama_rp[43:63]])
if (any(abs(dif_rama_rp) > 1e-6, na.rm = TRUE)) {
  stop("Identidad de rama r_p incumplida: total != formal + informal.")
}
rm(cols_rama_b14, cols_rama_rp, dif_rama_rp)

