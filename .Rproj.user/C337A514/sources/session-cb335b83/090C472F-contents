  resumen_base_post <- NULL
  message("Recreación completa desde periodo ", periodo_ini)
  
} else if (!is.null(periodo_ini) && file.exists(ruta_cubo_lectura)) {
  # Ventana específica o desde periodo_ini en adelante
  load(ruta_cubo_lectura)
