# CreaBBDD_Master_Excel.R - v5 - 22-08-2026
# Orquestador del pipeline Excel: único punto de entrada. Fija Trim_Actual
# una vez y lo propaga a los dos sub-scripts vía el entorno global.

if (!exists("fc_init_motor"))
  source(file.path(dirname(getwd()), "Bibliotecas_R", "funciones_pipeline.R"))

fc_init_motor(c("dplyr", "lubridate", "stringr"))

# ______________________________________________________________________________
# PARÁMETRO ÚNICO DEL PIPELINE ####
# Trim_Actual se fija aquí y se propaga a los sub-scripts vía el entorno global.
# ______________________________________________________________________________

# Trim_Actual se DEDUCE del directorio: la carpeta AAAAMM más reciente que
# exista en Datos_Ine/Exceles. Antes había un literal hardcodeado como valor por
# defecto, que envejece en silencio: el script corría con un trimestre viejo sin
# quejarse y el problema aparecía varios pasos después. Para forzar un período
# distinto, definir Trim_Actual ANTES de correr este archivo.
dire_excel_raiz <- file.path(dirname(dirname(getwd())), "Datos_Ine", "Exceles")

if (!exists("Trim_Actual") || is.null(Trim_Actual)) {
  periodos <- grep("^[0-9]{6}$", basename(list.dirs(dire_excel_raiz, recursive = FALSE)),
                   value = TRUE)
  if (!length(periodos))
    stop("No hay carpetas AAAAMM en ", dire_excel_raiz,
         ". Define Trim_Actual manualmente.", call. = FALSE)
  Trim_Actual <- max(periodos)
  message("Trim_Actual deducido del directorio: ", Trim_Actual)
}
if (!grepl("^[0-9]{6}$", Trim_Actual))
  stop("Trim_Actual debe ser AAAAMM de 6 dígitos (ej. \"202605\"). Valor actual: ", Trim_Actual)

# Si TRUE, re-ejecuta Series y Coyuntural antes de unir. Si ya los corriste en
# esta sesión con el mismo Trim_Actual, puedes poner FALSE y solo re-unir.
if (!exists("ejecutar_subscripts") || is.null(ejecutar_subscripts)) {
  ejecutar_subscripts <- TRUE
}

message("═══════════════════════════════════════════════")
message("PIPELINE EXCEL — Trim_Actual = ", Trim_Actual,
        "  | ejecutar_subscripts = ", ejecutar_subscripts)
message("═══════════════════════════════════════════════")

dire_out <- file.path(dirname(dirname(getwd())), "Datos_Ine", "ENE", "bbdd_minuta")
if (!dir.exists(dire_out)) {
  dir.create(dire_out, recursive = TRUE)
}

# ______________________________________________________________________________
# UBICACIÓN DE LOS SCRIPTS HERMANOS ####
# Deduce la carpeta de este .R (al sourcearlo, R deja la ruta en `ofile`).
# Si la detección falla, usa getwd(); siempre se puede fijar dir_scripts a mano.
# ______________________________________________________________________________

if (!exists("dir_scripts") || is.null(dir_scripts)) {
  dir_scripts <- tryCatch({
    of <- NULL
    for (i in seq_len(sys.nframe())) {
      f <- sys.frame(i)$ofile
      if (!is.null(f)) { of <- f; break }
    }
    if (is.null(of)) {                                   # caso Rscript --file=
      args <- commandArgs(trailingOnly = FALSE)
      fa   <- grep("^--file=", args, value = TRUE)
      if (length(fa)) of <- sub("^--file=", "", fa[1])
    }
    if (is.null(of)) getwd() else dirname(normalizePath(of))
  }, error = function(e) getwd())
}

ruta_series     <- file.path(dir_scripts, "intermedios", "CreaBBDD_Excel_Series.R")
ruta_coyuntural <- file.path(dir_scripts, "intermedios", "CreaBBDD_Excel_Coyuntural.R")

# ______________________________________________________________________________
# EJECUTAR SUB-SCRIPTS (heredan Trim_Actual) ####
# ______________________________________________________________________________

if (ejecutar_subscripts) {
  for (f in c(ruta_series, ruta_coyuntural)) {
    if (!file.exists(f))
      stop("No encuentro el sub-script: ", f,
           "\n   Fija dir_scripts a la carpeta que contiene los 3 scripts de Excel.")
  }
  message("→ Ejecutando Series ...");      source(ruta_series,     local = FALSE)
  message("→ Ejecutando Coyuntural ...");  source(ruta_coyuntural, local = FALSE)
}

# ______________________________________________________________________________
# CARGAR FUENTES (recién generadas con este mismo Trim_Actual) ####
# ______________________________________________________________________________

load(file.path(dire_out, "BBDD_Series.RData"))           # → dt_Series_Excel
load(file.path(dire_out, "BBDD_Coyuntural.RData"))       # → dt_Coyuntural

# ______________________________________________________________________________
# VARIABLES EXCLUSIVAS DE COYUNTURAL EN EL MES ACTUAL ####
# anti_join: de Coyuntural solo lo que dt_Series_Excel no cubre en ese periodo
# ______________________________________________________________________________

llave <- c("periodo", "fecha", "sexo", "sexo_label", "region", "region_label", "categoria")

dt_Coyuntural_excl <- anti_join(dt_Coyuntural, dt_Series_Excel, by = llave)

# ______________________________________________________________________________
# UNIÓN FINAL ####
# ______________________________________________________________________________

dt_ENE_Excel <- bind_rows(dt_Series_Excel, dt_Coyuntural_excl) %>%
  arrange(periodo, sexo, region, categoria)

# ______________________________________________________________________________
# GUARDAR ####
# ______________________________________________________________________________

save(dt_ENE_Excel, file = file.path(dire_out, "BBDD_Excel_Master.RData"))
message("Guardado en: ", file.path(dire_out, "BBDD_Excel_Master.RData"))

# ______________________________________________________________________________
# DIAGNÓSTICO FINAL ####
# ______________________________________________________________________________

message("═══════════════════════════════════════════════")
message("dt_ENE_Excel (Master — solo exceles oficiales)  |  Trim_Actual = ", Trim_Actual)
message("  Filas totales : ", nrow(dt_ENE_Excel))
message("  Períodos      : ", n_distinct(dt_ENE_Excel$periodo),
        "  [", min(dt_ENE_Excel$fecha), " → ", max(dt_ENE_Excel$fecha), "]")
message("  Categorías    : ", n_distinct(dt_ENE_Excel$categoria))
message("  Regiones      : ", n_distinct(dt_ENE_Excel$region_label))
message("  Filas Series  : ", nrow(dt_Series_Excel))
message("  Filas Coy excl: ", nrow(dt_Coyuntural_excl),
        " (periodo: ", paste(unique(dt_Coyuntural_excl$periodo), collapse = ", "), ")")
message("═══════════════════════════════════════════════")

