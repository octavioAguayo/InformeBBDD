# ==============================================================================
# PARÁMETROS — ajustar aquí antes de correr ####
# ------------------------------------------------------------------------------
# RecrearBase  : "Si" → procesar todo desde el inicio (ignora periodo_ini/fin)
#                "No" → carga incremental o ventana específica
#
# periodo_ini  : periodo desde el cual reprocesar (formato YYYYMM)
#                NULL  → desde el último periodo guardado + 1 (incremental normal)
#                valor → reprocesar desde ese periodo en adelante
#
# periodo_fin  : periodo hasta el cual reprocesar (formato YYYYMM, inclusive)
#                NULL  → sin límite superior (procesa hasta el .dta más nuevo)
#                valor → reprocesar solo la ventana [periodo_ini, periodo_fin]
#                        lo que viene después se conserva intacto
#
# Casos de uso:
#   Incremental normal   : RecrearBase="No", periodo_ini=NULL, periodo_fin=NULL
#   Recreación completa  : RecrearBase="Si", periodo_ini=NULL, periodo_fin=NULL
#   INE corrigió todo desde X : RecrearBase="No", periodo_ini=202001, periodo_fin=NULL
#   INE corrigió ventana X-Y  : RecrearBase="No", periodo_ini=202001, periodo_fin=202112
# ==============================================================================

RecrearBase <- "Si"
periodo_ini <- 202601   # ej: 202001
periodo_fin <- NULL   # ej: 202112  — NULL = sin límite superior

# ==============================================================================

dire_out <- file.path(dirname(dirname(getwd())), "Datos_Ine", "Procesados")
if (!dir.exists(dire_out)) dir.create(dire_out, recursive = TRUE)

fecha_Inicio_Covid <- as.Date("2020-01-01")
ruta_cubo          <- file.path(dire_out, "ENE_1_cubo.RData")

# ==============================================================================
# CARGAR DATOS ANTERIORES Y DEFINIR VENTANA DE PROCESAMIENTO ####
# ==============================================================================

if (RecrearBase == "Si") {
  # Recreación completa — partir desde el inicio de la serie
  periodo_ini      <- 201002
  periodo_fin      <- NULL
  resumen_base_ant <- NULL
  resumen_base_post <- NULL
  message("Recreación completa desde periodo ", periodo_ini)
  
} else if (!is.null(periodo_ini) && file.exists(ruta_cubo)) {
  # Ventana específica o desde periodo_ini en adelante
  load(ruta_cubo)
  resumen_base_ant  <- resumen_base %>% filter(periodo < periodo_ini)
  resumen_base_post <- if (!is.null(periodo_fin))
    resumen_base %>% filter(periodo > periodo_fin) else NULL
  msg <- paste0("Reprocesando desde ", periodo_ini)
  if (!is.null(periodo_fin)) msg <- paste0(msg, " hasta ", periodo_fin)
  message(msg, " | Anterior: ", n_distinct(resumen_base_ant$periodo),
          " períodos | Posterior: ",
          if (is.null(resumen_base_post)) 0 else n_distinct(resumen_base_post$periodo),
          " períodos retenidos.")
  
} else if (file.exists(ruta_cubo)) {
  # Carga incremental — procesar solo .dta nuevos desde el último periodo guardado
  load(ruta_cubo)
  periodo_ini       <- max(resumen_base$periodo) + 1
  resumen_base_ant  <- resumen_base
  resumen_base_post <- NULL
  message("Carga incremental — procesando .dta desde periodo ", periodo_ini)
  
} else {
  # Primera vez — no existe base previa
  periodo_ini       <- 201002
  periodo_fin       <- NULL
  resumen_base_ant  <- NULL
  resumen_base_post <- NULL
  message("Base no encontrada — procesando desde el inicio (", periodo_ini, ")")
}

