# ==============================================================================
# FUNCIÓN PRINCIPAL: procesa un .dta → resumen sexo × region ####
# Un solo group_by con todas las dimensiones base del cubo.
# AS y Nacional se construyen después por colapso — no dentro de esta función.
# ==============================================================================

procesar_dta <- function(archivo) {
  
  # Leer variables disponibles ####
  vars_actuales <- names(read_dta(archivo, n_max = 0))
  vars_a_leer   <- c(vars_base, intersect(vars_opcionales, vars_actuales))
  ene           <- read_dta(archivo, col_select = all_of(vars_a_leer))
  
  # Rellenar opcionales ausentes con NA ####
  for (v in setdiff(vars_opcionales, names(ene))) ene[[v]] <- NA_integer_
  
  # Limpiar etiquetas haven ####
  ene <- ene %>%
    mutate(across(everything(), ~ as.numeric(haven::zap_labels(.))))
  
  # Período ####
  ene <- ene %>%
    mutate(
      periodo = ano_trimestre * 100 + mes_central,
      fecha   = make_date(ano_trimestre, mes_central, 1)
    )
  
  # Indicadores derivados: calcular si no vienen en el .dta ####
  # tpi: habituales < 31 & c10==1 & c11 %in% c(1,2)
  if (all(is.na(ene$tpi)) && "c10" %in% names(ene) && "c11" %in% names(ene)) {
    ene <- ene %>%
      mutate(tpi = as.integer(cae_especifico %in% 1:7 & habituales < 31 &
                                c10 == 1 & c11 %in% c(1, 2)))
  }
  
  # Dimensiones adicionales del cubo ####
  # Se construyen antes del summarise — necesitan microdatos
  ene <- ene %>%
    mutate(
      nacionalidad    = fc_nacionalidad(nacionalidad),
      nivel_educativo = fc_nivel_educativo(if_else(cine11_2d == 99, NA_real_, cine11_2d)),
      tramo_edad      = fc_t_edad_ine(tramo_edad),
      tamano_empresa  = case_when(
        b15_1 %in% c(1, 2)  ~ 1L,   # Micro    (1-10 personas)
        b15_1 == 3           ~ 2L,   # Pequeña  (11-49)
        b15_1 == 4           ~ 3L,   # Mediana  (50-199)
        b15_1 == 5           ~ 4L,   # Gran     (200+)
        b15_1 %in% c(88, 99) ~ 5L,   # Sin clasificar (NS/NR)
        TRUE                 ~ NA_integer_
      )
    )
  
  # ===========================================================================
  # SUMMARISE — group_by único: periodo × fecha × sexo × region × nacionalidad × nivel_educativo × tramo_edad
  # Produce stocks base (Tipo 1) y auxiliares de paso (Tipo 2).
  # Las derivadas (tasas, promedios, identidades) se calculan en post-proceso.
  # AS y Nacional se construyen después por colapso OLAP — no dentro de esta función.
  # ===========================================================================
  
  ene %>%
    group_by(periodo, fecha, sexo, region, nacionalidad, nivel_educativo, tramo_edad) %>%
    summarise(
      
      # --- Mercado laboral principal ---
      Poblacion        = sum(fact_cal,                                          na.rm = TRUE),
      PET              = sum(fact_cal[edad >= 15],                              na.rm = TRUE),
      FT               = sum(fact_cal[cae_especifico %in% 1:9],                 na.rm = TRUE),
      Ocupados         = sum(fact_cal[cae_especifico %in% 1:7],                 na.rm = TRUE),
      Desocupados      = sum(fact_cal[cae_especifico %in% c(8, 9)],             na.rm = TRUE),
      Cesantes         = sum(fact_cal[cae_especifico == 8],                     na.rm = TRUE),
      B_t_p_v          = sum(fact_cal[cae_especifico == 9],                     na.rm = TRUE),
      FFT              = sum(fact_cal[activ == 3],                              na.rm = TRUE),
      FFT_Iniciadores  = sum(fact_cal[cae_especifico %in% c(10, 11)],           na.rm = TRUE),
      FFT_Inactivos_PA = sum(fact_cal[!is.na(ftp) & ftp == 1],                  na.rm = TRUE),
      FFT_Inactivos_H  = sum(fact_cal[activ == 3 &
                                        !cae_especifico %in% c(10, 11) &
                                        (is.na(ftp) | ftp == 0)],               na.rm = TRUE),
      
      # --- Subutilización ---
      Iniciadores_disp       = sum(fact_cal[!is.na(id)  & id  == 1],            na.rm = TRUE),
      Tiemp_parcial_involunt = sum(fact_cal[!is.na(tpi) & tpi == 1],            na.rm = TRUE),
      Ocup_buscaron_empleo   = sum(fact_cal[!is.na(obe) & obe == 1],            na.rm = TRUE),
      FT_potencial           = sum(fact_cal[!is.na(ftp) & ftp == 1],            na.rm = TRUE),
      FT_ampliada            = sum(fact_cal[cae_especifico %in%
                                              c(1:9, 10, 12, 14, 16, 18, 20, 22, 25, 26, 27)],
                                   na.rm = TRUE),
      Desea_trabajar         = sum(fact_cal[!is.na(deseo_trabajar) &
                                              deseo_trabajar == 1],             na.rm = TRUE),
      
      # --- Categoría ocupacional ---
      Empleadores       = sum(fact_cal[activ==1 & categoria_ocupacion==1],      na.rm = TRUE),
      Cuenta_propia     = sum(fact_cal[activ==1 & categoria_ocupacion==2],      na.rm = TRUE),
      Asal_privados     = sum(fact_cal[activ==1 & categoria_ocupacion==3],      na.rm = TRUE),
      Asal_publico      = sum(fact_cal[activ==1 & categoria_ocupacion==4],      na.rm = TRUE),
      ServDom_afuera    = sum(fact_cal[activ==1 & categoria_ocupacion==5],      na.rm = TRUE),
      ServDom_adentro   = sum(fact_cal[activ==1 & categoria_ocupacion==6],      na.rm = TRUE),
      Familiares_no_rem = sum(fact_cal[activ==1 & categoria_ocupacion==7],      na.rm = TRUE),
      
      # --- Informalidad por categoría (desde JAS 2017) ---
      Ocup_formales  = sum(fact_cal[!is.na(ocup_form) & ocup_form==1],          na.rm = TRUE),
      Ocup_informales= sum(fact_cal[!is.na(ocup_form) & ocup_form==2],          na.rm = TRUE),
      Empl_form      = sum(fact_cal[activ==1 & categoria_ocupacion==1 & !is.na(ocup_form) & ocup_form==1], na.rm = TRUE),
      Empl_inf       = sum(fact_cal[activ==1 & categoria_ocupacion==1 & !is.na(ocup_form) & ocup_form==2], na.rm = TRUE),
      CtaProp_form   = sum(fact_cal[activ==1 & categoria_ocupacion==2 & !is.na(ocup_form) & ocup_form==1], na.rm = TRUE),
      CtaProp_inf    = sum(fact_cal[activ==1 & categoria_ocupacion==2 & !is.na(ocup_form) & ocup_form==2], na.rm = TRUE),
      AslPriv_form   = sum(fact_cal[activ==1 & categoria_ocupacion==3 & !is.na(ocup_form) & ocup_form==1], na.rm = TRUE),
      AslPriv_inf    = sum(fact_cal[activ==1 & categoria_ocupacion==3 & !is.na(ocup_form) & ocup_form==2], na.rm = TRUE),
      AslPub_form    = sum(fact_cal[activ==1 & categoria_ocupacion==4 & !is.na(ocup_form) & ocup_form==1], na.rm = TRUE),
      AslPub_inf     = sum(fact_cal[activ==1 & categoria_ocupacion==4 & !is.na(ocup_form) & ocup_form==2], na.rm = TRUE),
      ServDom_form   = sum(fact_cal[activ==1 & categoria_ocupacion %in% c(5,6) & !is.na(ocup_form) & ocup_form==1], na.rm = TRUE),
      ServDom_inf    = sum(fact_cal[activ==1 & categoria_ocupacion %in% c(5,6) & !is.na(ocup_form) & ocup_form==2], na.rm = TRUE),
      FamNoRem_inf   = sum(fact_cal[activ==1 & categoria_ocupacion==7 & !is.na(ocup_form) & ocup_form==2], na.rm = TRUE),
      
      # --- Grupos ocupacionales (b1, CIUO-08, desde EFM 2017) ---
      GOcup_Dir  = sum(fact_cal[activ==1 & !is.na(b1) & b1==1], na.rm = TRUE),
      GOcup_Prof = sum(fact_cal[activ==1 & !is.na(b1) & b1==2], na.rm = TRUE),
      GOcup_Tec  = sum(fact_cal[activ==1 & !is.na(b1) & b1==3], na.rm = TRUE),
      GOcup_Adm  = sum(fact_cal[activ==1 & !is.na(b1) & b1==4], na.rm = TRUE),
      GOcup_Serv = sum(fact_cal[activ==1 & !is.na(b1) & b1==5], na.rm = TRUE),
      GOcup_Agr  = sum(fact_cal[activ==1 & !is.na(b1) & b1==6], na.rm = TRUE),
      GOcup_Art  = sum(fact_cal[activ==1 & !is.na(b1) & b1==7], na.rm = TRUE),
      GOcup_Oper = sum(fact_cal[activ==1 & !is.na(b1) & b1==8], na.rm = TRUE),
      GOcup_Elem = sum(fact_cal[activ==1 & !is.na(b1) & b1==9], na.rm = TRUE),
      # Formal e informal por grupo ocupacional (desde JAS 2017)
      GOcup_Dir_F  = sum(fact_cal[activ==1 & !is.na(b1) & b1==1 & !is.na(ocup_form) & ocup_form==1], na.rm = TRUE),
      GOcup_Prof_F = sum(fact_cal[activ==1 & !is.na(b1) & b1==2 & !is.na(ocup_form) & ocup_form==1], na.rm = TRUE),
      GOcup_Tec_F  = sum(fact_cal[activ==1 & !is.na(b1) & b1==3 & !is.na(ocup_form) & ocup_form==1], na.rm = TRUE),
      GOcup_Adm_F  = sum(fact_cal[activ==1 & !is.na(b1) & b1==4 & !is.na(ocup_form) & ocup_form==1], na.rm = TRUE),
      GOcup_Serv_F = sum(fact_cal[activ==1 & !is.na(b1) & b1==5 & !is.na(ocup_form) & ocup_form==1], na.rm = TRUE),
      GOcup_Agr_F  = sum(fact_cal[activ==1 & !is.na(b1) & b1==6 & !is.na(ocup_form) & ocup_form==1], na.rm = TRUE),
      GOcup_Art_F  = sum(fact_cal[activ==1 & !is.na(b1) & b1==7 & !is.na(ocup_form) & ocup_form==1], na.rm = TRUE),
      GOcup_Oper_F = sum(fact_cal[activ==1 & !is.na(b1) & b1==8 & !is.na(ocup_form) & ocup_form==1], na.rm = TRUE),
      GOcup_Elem_F = sum(fact_cal[activ==1 & !is.na(b1) & b1==9 & !is.na(ocup_form) & ocup_form==1], na.rm = TRUE),
      GOcup_Dir_I  = sum(fact_cal[activ==1 & !is.na(b1) & b1==1 & !is.na(ocup_form) & ocup_form==2], na.rm = TRUE),
