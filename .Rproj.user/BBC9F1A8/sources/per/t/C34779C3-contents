      GOcup_Tec_I  = sum(fact_cal[activ==1 & !is.na(b1) & b1==3 & !is.na(ocup_form) & ocup_form==2], na.rm = TRUE),
      GOcup_Adm_I  = sum(fact_cal[activ==1 & !is.na(b1) & b1==4 & !is.na(ocup_form) & ocup_form==2], na.rm = TRUE),
      GOcup_Serv_I = sum(fact_cal[activ==1 & !is.na(b1) & b1==5 & !is.na(ocup_form) & ocup_form==2], na.rm = TRUE),
