      GOcup_Art_I  = sum(fact_cal[activ==1 & !is.na(b1) & b1==7 & !is.na(ocup_form) & ocup_form==2], na.rm = TRUE),
      GOcup_Oper_I = sum(fact_cal[activ==1 & !is.na(b1) & b1==8 & !is.na(ocup_form) & ocup_form==2], na.rm = TRUE),
      GOcup_Elem_I = sum(fact_cal[activ==1 & !is.na(b1) & b1==9 & !is.na(ocup_form) & ocup_form==2], na.rm = TRUE),
      
      # --- Tamaño de empresa (b15_1, desde Nov-Ene 2019) ---
      # Agrupación: 1+2=Micro (1-10), 3=Pequeña, 4=Mediana, 5=Gran, 88+99=Sin clasificar
