# Mapeo nombre interno → nombre canónico (incluye tasas calculadas en derivadas)
vars_edad <- tribble(
  ~col_interna,        ~categoria_base,
  "Poblacion",         "Población",
  "PET",               "PET",
  "FT",                "Fuerza de Trabajo",
  "Ocupados",          "Ocupados",
  "Ocup_formales",     "Ocupados formales",
  "Ocup_informales",   "Ocupados informales",
  "Desocupados",       "Desocupados",
  "Cesantes",          "Cesantes",
  "B_t_p_v",           "B_t_p_v",
  "FFT",               "FFT",
  "FFT_Iniciadores",   "FFT_Iniciadores",
  "FFT_Inactivos_PA",  "FFT_Inactivos_PA",
  "FFT_Inactivos_H",   "FFT_Inactivos_H",
  "T_desocupacion",    "Tasa de desocupación",
  "T_ocupacion",       "Tasa de ocupación",
  "T_participacion",   "Tasa de participación",
  "T_Informal",        "Tasa de ocupación informal",
  "T_Cesantia",        "Tasa de cesantía",
  "T_Btrab",           "Tasa búsqueda trabajo"
)

tasas_edad <- c(
  "Tasa de desocupación", "Tasa de ocupación", "Tasa de participación",
  "Tasa de ocupación informal", "Tasa de cesantía", "Tasa búsqueda trabajo"
)

dt_edad <- resumen_Edad %>%
  filter(!is.na(tramo_edad)) %>%
  mutate(tramo_label = tramo_edad) %>%
  pivot_longer(
    cols      = all_of(vars_edad$col_interna),
    names_to  = "col_interna",
    values_to = "valor"
  ) %>%
  left_join(vars_edad, by = "col_interna") %>%
  filter(!is.na(valor)) %>%
  mutate(
    categoria = paste0(categoria_base, "-", tramo_label),
    valor     = if_else(categoria_base %in% tasas_edad,
                        round(valor, 1),
                        round(valor, 0)),
    sexo_label = case_when(
      sexo == 0 ~ "Ambos sexos",
      sexo == 1 ~ "Hombres",
      sexo == 2 ~ "Mujeres",
      TRUE      ~ as.character(sexo)
    ),
    sexo = case_when(
      sexo == 0 ~ "AS", sexo == 1 ~ "H", sexo == 2 ~ "M",
      TRUE      ~ as.character(sexo)
    ),
    region_label = case_when(
      region ==  0 ~ "Total nacional",
      region == 15 ~ "Arica y Parinacota",
      region ==  1 ~ "Tarapacá",
      region ==  2 ~ "Antofagasta",
      region ==  3 ~ "Atacama",
      region ==  4 ~ "Coquimbo",
      region ==  5 ~ "Valparaíso",
      region ==  6 ~ "O'Higgins",
      region ==  7 ~ "Maule",
      region == 16 ~ "Ñuble",
      region ==  8 ~ "Biobío",
      region ==  9 ~ "La Araucanía",
      region == 14 ~ "Los Ríos",
      region == 10 ~ "Los Lagos",
      region == 11 ~ "Aysén",
      region == 12 ~ "Magallanes",
      region == 13 ~ "Metropolitana",
      TRUE         ~ as.character(region)
    ),
    region = case_when(
      region ==  0 ~ "TT", region == 15 ~ "AP", region ==  1 ~ "TA",
      region ==  2 ~ "AN", region ==  3 ~ "AT", region ==  4 ~ "CO",
      region ==  5 ~ "VA", region ==  6 ~ "LI", region ==  7 ~ "ML",
      region == 16 ~ "NB", region ==  8 ~ "BI", region ==  9 ~ "AR",
      region == 14 ~ "LR", region == 10 ~ "LL", region == 11 ~ "AI",
      region == 12 ~ "MA", region == 13 ~ "RM", TRUE ~ as.character(region)
    )
  ) %>%
  select(periodo, fecha, sexo, sexo_label, region, region_label, categoria, valor)

dt_ENE_Stata <- bind_rows(dt_ENE_Stata, dt_edad)

