# ==============================================================================
# ENE_2_Colapso_SexoRegionEdad.R
# Produce dos colapsos del cubo ENE para distintos usos:
#
#   resumen_SexoRegion  — colapsa tramo_edad, nacionalidad, nivel_educativo
#                         → sexo × region | base para series y coyuntural regional
#
#   resumen_Edad        — colapsa nacionalidad, nivel_educativo
#                         → sexo × region × tramo_edad, serie completa de períodos
#                         → base para sección 2.3 (mercado laboral × edad)
#                         → solo stocks: tasas se recalculan en ENE_3_Derivadas
#
# Ambos resultados se guardan en el mismo .RData junto a resumen_base.
# ==============================================================================
# Entrada:  ENE_1_cubo.RData  (resumen_base)
# Salida:   ENE_2_SexoRegionEdad.RData  (resumen_base, resumen_SexoRegion, resumen_Edad)
# ==============================================================================

source(file.path(dirname(getwd()), "Bibliotecas_R", "funciones_ene.R"))

fc_init_motor(c("dplyr", "tidyr", "lubridate"))

dire_out <- file.path(dirname(dirname(getwd())), "Datos_Ine", "Procesados")

# ==============================================================================
# CARGAR CUBO ####
# ==============================================================================

load(file.path(dire_out, "ENE_1_cubo.RData"))

# ==============================================================================
# COLAPSO 1 — sexo × region ####
# Colapsa tramo_edad, nacionalidad y nivel_educativo sumando stocks.
# Luego construye AS por colapso de sexo y Nacional por colapso de region.
# ==============================================================================

dims_sr     <- c("periodo", "fecha", "sexo", "region")
cols_stocks <- setdiff(names(resumen_base),
                       c(dims_sr, "tramo_edad", "nacionalidad", "nivel_educativo"))

# Paso 1a — colapsar dimensiones no usadas
resumen_sr <- resumen_base %>%
  group_by(across(all_of(dims_sr))) %>%
  summarise(across(all_of(cols_stocks), ~ sum(.x, na.rm = TRUE)), .groups = "drop")

# Paso 1b — Ambos sexos por región
resumen_as <- resumen_sr %>%
  group_by(periodo, fecha, region) %>%
  summarise(across(all_of(cols_stocks), ~ sum(.x, na.rm = TRUE)), .groups = "drop") %>%
  mutate(sexo = 0) %>%
  select(periodo, fecha, sexo, region, everything())

resumen_regional <- bind_rows(resumen_sr, resumen_as)

# Paso 1c — Nacional (H, M y AS en un solo group_by)
resumen_nacional <- resumen_regional %>%
  group_by(periodo, fecha, sexo) %>%
  summarise(across(all_of(cols_stocks), ~ sum(.x, na.rm = TRUE)), .groups = "drop") %>%
  mutate(region = 0) %>%
  select(periodo, fecha, sexo, region, everything())

# Tabla completa
resumen_SexoRegion <- bind_rows(resumen_regional, resumen_nacional)

# ==============================================================================
# COLAPSO 2 — sexo × region × tramo_edad, serie completa ####
# Solo stocks — las tasas se recalculan desde estos stocks en ENE_3_Derivadas
# para mantener consistencia con el resto de la cadena.
# Vector canónico converge con vars_edad de CreaBBDD_Coyuntural_v2.
# ==============================================================================

# Stocks de edad — nombres internos de resumen_base
# (la traducción a nombres canónicos ocurre en ENE_3)
vars_edad <- c(
  "Poblacion", "PET", "FT", "Ocupados", "Ocup_formales", "Ocup_informales",
  "Desocupados", "Cesantes", "B_t_p_v", "FFT", "FFT_Iniciadores",
  "FFT_Inactivos_PA", "FFT_Inactivos_H"
)
# Excluidos aquí — se recalculan en ENE_3_Derivadas desde stocks:
#   "Tasa de desocupación", "Tasa de ocupación",
#   "Tasa de participación", "Tasa de ocupación informal"

dims_edad <- c("periodo", "fecha", "sexo", "region", "tramo_edad")

# Paso 2a — colapsar nacionalidad y nivel_educativo para TODOS los períodos
resumen_edad_base <- resumen_base %>%
  group_by(across(all_of(dims_edad))) %>%
  summarise(across(all_of(vars_edad), ~ sum(.x, na.rm = TRUE)), .groups = "drop")

# Paso 2b — Ambos sexos por region × tramo
resumen_edad_as <- resumen_edad_base %>%
  group_by(periodo, fecha, region, tramo_edad) %>%
  summarise(across(all_of(vars_edad), ~ sum(.x, na.rm = TRUE)), .groups = "drop") %>%
  mutate(sexo = 0) %>%
  select(periodo, fecha, sexo, region, tramo_edad, everything())

# Paso 2c — Nacional (region = 0): colapsar region solo sobre edad_base (H+M)
# NO incluir resumen_edad_as: sexo=0 ya es suma de H+M, sumarlos daría triple conteo
resumen_edad_nac <- resumen_edad_base %>%
  group_by(periodo, fecha, sexo, tramo_edad) %>%
  summarise(across(all_of(vars_edad), ~ sum(.x, na.rm = TRUE)), .groups = "drop") %>%
  mutate(region = 0) %>%
  select(periodo, fecha, sexo, region, tramo_edad, everything())

# Agregar AS nacional colapsando resumen_edad_as sobre region
resumen_edad_nac_as <- resumen_edad_as %>%
  group_by(periodo, fecha, sexo, tramo_edad) %>%
  summarise(across(all_of(vars_edad), ~ sum(.x, na.rm = TRUE)), .groups = "drop") %>%
  mutate(region = 0) %>%
  select(periodo, fecha, sexo, region, tramo_edad, everything())

resumen_edad_nac <- bind_rows(resumen_edad_nac, resumen_edad_nac_as)

resumen_Edad <- bind_rows(resumen_edad_base, resumen_edad_as, resumen_edad_nac)

# ==============================================================================
# GUARDAR ####
# ==============================================================================

save(resumen_base, resumen_SexoRegion, resumen_Edad,
     file = file.path(dire_out, "ENE_2_SexoRegionEdad.RData"))

message("Colapso 1 (SexoRegion): ", nrow(resumen_SexoRegion), " filas | ",
        n_distinct(resumen_SexoRegion$periodo), " períodos.")
message("Colapso 2 (Edad): ", nrow(resumen_Edad), " filas | ",
        n_distinct(resumen_Edad$periodo), " períodos | ",
        n_distinct(resumen_Edad$tramo_edad), " tramos | ",
        length(vars_edad), " variables de stock.")