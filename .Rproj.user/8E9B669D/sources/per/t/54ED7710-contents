fc_apps_cotizan <- function(x, apps) {
  ifelse(
    is.na(x),
    FALSE,
    sapply(x, function(txt) {
      txt_up <- toupper(txt)
      any(grepl(paste0("\\b(", paste(apps, collapse = "|"), ")\\b"), txt_up))
    })
  )
}

fc_clasificar_informal <- function(df, apps_cotizan, periodo_ley_plataformas) {
  df %>% mutate(
    ocup_form_alternativo = case_when(
      ocup_form_alternativo == 2 & categoria_ocupacion %in% 3:6 &
        edad > 64 & sexo == 1 & b7a_1 %in% c(2, 77) & b7a_2 == 1 ~ 3,
      ocup_form_alternativo == 2 & categoria_ocupacion %in% 3:6 &
        edad > 59 & sexo == 2 & b7a_1 %in% c(2, 77) & b7a_2 == 1 ~ 3,
      ocup_form_alternativo == 2 & categoria_ocupacion == 4 &
        ocup_honorarios == 1 ~ 5,
      ocup_form_alternativo == 2 & periodo >= periodo_ley_plataformas &
        plataformas_digitales == 1 &
        fc_apps_cotizan(pd_especifique, apps_cotizan) ~ 6,
      ocup_form_alternativo == 2 & categoria_ocupacion == 2 ~ 7,
      TRUE ~ ocup_form_alternativo
    )
  )
}

