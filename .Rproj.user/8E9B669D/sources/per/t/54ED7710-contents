# ______________________________________________________________________________
# Archivos de la ENE ####
# ______________________________________________________________________________

# Trampa: filtra por el período del NOMBRE del archivo, no por su contenido.
# Espera la convención ene-AAAA-MM-*.dta bajo Datos_Ine/ENE.
fc_archivos_ene <- function(periodo_inicio = 201708) {
  dire <- file.path(dirname(dirname(getwd())), "Datos_Ine", "ENE")
  archivos <- list.files(
    path       = dire,
    pattern    = "^ene-\\d{4}-\\d{2}-.*\\.dta$",
    full.names = TRUE
  )
  archivos <- keep(archivos, function(x) {
    nombre <- basename(x)
    anio   <- as.integer(str_extract(nombre, "(?<=ene-)\\d{4}"))
    mes    <- as.integer(str_extract(nombre, "(?<=ene-\\d{4}-)\\d{2}"))
    anio * 100 + mes >= periodo_inicio
  })
  sort(archivos)
}


