fc_nacionalidad_amp <- function(nacionalidad){
  case_when(
    nacionalidad == 152 ~ 10L,
    nacionalidad %in% c(170, 862, 332, 218, 32, 608, 68) ~ 21L,
    is.na(nacionalidad) | nacionalidad %in% c(898, 999) ~ NA_integer_,
    TRUE ~ 22L
