fc_poblacion_ene_label <- function(poblacion) {
  poblacion <- match.arg(
    poblacion,
    c("total", "mujeres", "jovenes", "55_mas")
  )

  switch(
    poblacion,
    total = "Total de ocupados",
    mujeres = "Mujeres ocupadas",
    jovenes = "Personas ocupadas de 15 a 29 años",
    `55_mas` = "Personas ocupadas de 55 años o más"
  )
}

fc_filtrar_poblacion_ene <- function(datos, poblacion = "total") {
  poblacion <- match.arg(
    poblacion,
    c("total", "mujeres", "jovenes", "55_mas")
  )

  columnas_faltantes <- setdiff(c("sexo", "tramo_edad"), names(datos))
  if (length(columnas_faltantes) > 0) {
    stop(
      "Faltan columnas para filtrar la población ENE: ",
      paste(columnas_faltantes, collapse = ", "),
      call. = FALSE
    )
  }

  resultado <- switch(
    poblacion,
    total = datos,
    mujeres = filter(datos, .data$sexo == 2),
    jovenes = filter(datos, .data$tramo_edad %in% 1:3),
    `55_mas` = filter(datos, .data$tramo_edad %in% 9:12)
  )

  if (nrow(resultado) == 0) {
    stop(
      "El filtro de población '", poblacion, "' no contiene observaciones.",
      call. = FALSE
    )
  }

  attr(resultado, "poblacion") <- poblacion
  attr(resultado, "poblacion_label") <- fc_poblacion_ene_label(poblacion)
  resultado
}

