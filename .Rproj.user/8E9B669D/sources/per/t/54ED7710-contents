fc_meses_desocupacion <- function(e6_ano, e6_mes, ano_ref, mes_ref) {
  e6_ano  <- as.numeric(zap_labels(e6_ano))
  e6_mes  <- as.numeric(zap_labels(e6_mes))
  ano_ref <- as.numeric(zap_labels(ano_ref))
  mes_ref <- as.numeric(zap_labels(mes_ref))
  e6_ano[e6_ano %in% c(88, 99, 8888, 9999)] <- NA
  e6_mes[e6_mes %in% c(88, 99)]             <- NA
  meses <- fc_delta_meses(e6_ano, e6_mes, ano_ref, mes_ref)
  meses[meses < 0] <- NA
  return(as.integer(meses))
}

